"dropfeed_fh.equipment" = "Court, racket, 10+ balls, a basket or bag";
"dropfeed_fh.cue" = "Let the ball drop to waist height, then swing.";
"dropfeed_fh.mistake" = "Rushing the feed and hitting the ball on the rise.";
"dropfeed_fh.1.title" = "Drop and catch";
"dropfeed_fh.1.body" = "Drop a ball beside your front foot and catch it after one bounce. Find the spot where it bounces to waist height.";
"dropfeed_fh.2.title" = "Ten-ball sets";
"dropfeed_fh.2.body" = "Drop, let it bounce, then hit a cross-court forehand past the service line. Collect balls between sets and rest.";
"dropfeed_fh.3.title" = "Final ten";
"dropfeed_fh.3.body" = "Hit 10 drop-feed forehands. Count balls landing beyond the service line and inside the singles court.";
"dropfeed_bh.title" = "Drop-feed backhands";
"dropfeed_bh.subtitle" = "Solo backhands from your own feed, cross-court.";
"dropfeed_bh.goal" = "Grow confidence on the backhand side with an easy, repeatable ball.";
"dropfeed_bh.equipment" = "Court, racket, 10+ balls, a basket or bag";
"dropfeed_bh.cue" = "Turn your shoulders before the ball bounces.";
"dropfeed_bh.mistake" = "Facing the net at contact and pushing with the arm.";
"dropfeed_bh.1.title" = "Set up the turn";
"dropfeed_bh.1.body" = "Stand side-on, drop a ball and let it bounce twice while you hold your shoulder turn. Repeat until the turn feels natural.";
"dropfeed_bh.2.title" = "Ten-ball sets";
"dropfeed_bh.2.body" = "Drop, let it bounce once, then hit a cross-court backhand. One- or two-handed, keep the same rhythm. Collect balls and rest between sets.";
"dropfeed_bh.3.title" = "Final ten";
"dropfeed_bh.3.body" = "Hit 10 backhands. Count balls landing cross-court inside the singles court.";
"toss.title" = "A toss you can trust";
"toss.subtitle" = "Make the serve toss steady before adding power.";
"toss.goal" = "Place the toss in the same spot, slightly in front and towards your hitting side.";
"toss.equipment" = "Racket, a few balls; a racket cover or towel as a target";
"toss.cue" = "Lift, don't throw. Release at eye height.";
"toss.mistake" = "Flicking the wrist so the toss drifts behind your head.";
"toss.1.title" = "Find your spot";
"toss.1.body" = "Lay your racket cover a step in front of your front foot, towards your hitting side. Stand in your serving stance.";
"toss.2.title" = "Toss and let it land";
"toss.2.body" = "Toss to your reach height and let the ball drop without hitting it. Watch where it lands. Rest your arm every 10 tosses.";
"toss.3.title" = "Ten-toss check";
"toss.3.body" = "Make 10 tosses. Count those landing on or touching the target.";
"second_serve.title" = "A second serve you trust";
"second_serve.subtitle" = "Spin and margin over pace.";
"second_serve.goal" = "Land a reliable serve with net clearance and a calm rhythm.";
"second_serve.equipment" = "Court, racket, 10+ balls";
"second_serve.cue" = "Aim higher over the net and keep swinging.";
"second_serve.mistake" = "Slowing the arm down to guide the ball in.";
"second_serve.1.title" = "Easy rhythm";
"second_serve.1.body" = "Warm up your shoulder with gentle serves from the service line, then move back to the baseline.";
"second_serve.2.title" = "Clear the net";
"second_serve.2.body" = "Serve at a relaxed pace, aiming a racket's height above the net. Keep the same full swing: let height, not a slower arm, give you safety. Rest every 10 serves.";
"second_serve.3.title" = "Pressure ten";
"second_serve.3.body" = "Treat every serve as a second serve. Hit 10 and count those landing in the correct service box.";
"wall_volley.title" = "Wall volleys";
"wall_volley.subtitle" = "Quick hands and a firm wrist against the wall.";
"wall_volley.goal" = "Build a compact volley with short preparation and a steady racket face.";
"wall_volley.equipment" = "A practice wall, racket, 1–2 balls";
"wall_volley.cue" = "Short punch, no backswing.";
"wall_volley.mistake" = "Swinging at the ball instead of blocking it.";
"wall_volley.1.title" = "Volley and catch";
"wall_volley.1.body" = "Stand 2–3 metres from the wall. Hit gentle forehand volleys and catch the ball after each one.";
"wall_volley.2.title" = "Keep it going";
"wall_volley.2.body" = "Volley continuously at a calm pace. Alternate forehand and backhand volleys when you feel ready. Step back if it gets too fast.";
"wall_volley.3.title" = "Best streak";
"wall_volley.3.body" = "Count your longest run of volleys without a bounce.";
"split.title" = "Split step timing";
"split.subtitle" = "Land as the ball is struck, then move.";
"split.goal" = "Time a small split step so your first step is quick and balanced.";
"split.equipment" = "Clear court space; 3 flat markers optional";
"split.cue" = "Hop as they hit, land as you read.";
"split.mistake" = "Jumping too high or too early and landing flat-footed.";
"split.1.title" = "Small hops";
"split.1.body" = "Do light, low hops on the balls of your feet. Keep your knees soft.";
"split.2.title" = "Hop and go";
"split.2.body" = "From the centre, picture an opponent's contact. Split step, take a first step left or right towards a marker, then recover. Alternate sides and rest between rounds.";
"split.3.title" = "Five rounds";
"split.3.body" = "Do 5 rounds of split step, move and recover. Count rounds where you landed in balance and moved without a pause.";
"approach.title" = "Approach and close";
"approach.subtitle" = "Attack a short ball and finish at the net.";
"approach.goal" = "Recognise a short ball, hit it deep and move forward to volley.";
"approach.equipment" = "Court, racket, balls, a partner to feed";
"approach.cue" = "Hit through the ball and keep moving forward.";
"approach.mistake" = "Stopping after the approach and getting caught mid-court.";
"approach.1.title" = "Short-ball feeds";
"approach.1.body" = "Your partner feeds a soft ball that lands near the service line. Step in, hit it deep, then reset.";
"approach.2.title" = "Approach plus volley";
"approach.2.body" = "After the approach, split step near the service line, then volley your partner's gentle reply. Switch roles regularly.";
"approach.3.title" = "Ten approaches";
"approach.3.body" = "Play 10 approach-and-volley sequences. Count those where both shots land in.";
"overhead.title" = "Lob and overhead";
"overhead.subtitle" = "Turn, point and finish the high ball.";
"overhead.goal" = "Track a lob with a side-on turn and hit a controlled overhead.";
"overhead.equipment" = "Court, racket, balls, a partner to lob";
"overhead.cue" = "Turn sideways and point at the ball with your free hand.";
"overhead.mistake" = "Backpedalling while facing the net and losing balance.";
"overhead.1.title" = "Turn and catch";
"overhead.1.body" = "Your partner hits gentle lobs. Turn side-on, point and catch the ball with your free hand.";
"overhead.2.title" = "Controlled overheads";
"overhead.2.body" = "Hit overheads at three-quarter pace into the opposite court. Move back with side steps instead of running backwards. Switch roles.";
"overhead.3.title" = "Ten overheads";
"overhead.3.body" = "Hit 10 overheads. Count those landing in the singles court.";
"demo.description.shadow" = "No ball needed. Move along the baseline, swing, and recover to the centre after every shot.";
"demo.description.split" = "Start in the centre, split step, take a first step to one side and recover.";
"demo.description.approach" = "Move in from the baseline to the short ball, hit deep, then close towards the net.";
"demo.description.overhead" = "The lob comes over your head. Turn side-on, then hit the overhead into the opposite court.";
