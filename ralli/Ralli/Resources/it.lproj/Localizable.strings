"dropfeed_bh.title" = "Rovesci con autolancio";
"dropfeed_bh.subtitle" = "Rovesci incrociati da solo con il tuo lancio.";
"dropfeed_bh.goal" = "Acquistare fiducia sul rovescio con una palla facile e ripetibile.";
"dropfeed_bh.equipment" = "Campo, racchetta, 10+ palline, un cesto o una borsa";
"dropfeed_bh.cue" = "Ruota le spalle prima che la palla rimbalzi.";
"dropfeed_bh.mistake" = "Essere frontale alla rete all’impatto e spingere con il braccio.";
"dropfeed_bh.1.title" = "Prepara la rotazione";
"dropfeed_bh.1.body" = "Mettiti di lato, lascia cadere una palla e falla rimbalzare due volte mantenendo la rotazione delle spalle. Ripeti finché la rotazione ti viene naturale.";
"dropfeed_bh.2.title" = "Serie da dieci palle";
"dropfeed_bh.2.body" = "Lascia cadere, un rimbalzo, poi colpisci un rovescio incrociato. A una o due mani, mantieni lo stesso ritmo. Raccogli le palline e riposa tra le serie.";
"dropfeed_bh.3.title" = "Le ultime dieci";
"dropfeed_bh.3.body" = "Colpisci 10 rovesci. Conta le palle che cadono incrociate nel campo del singolare.";
"toss.title" = "Un lancio affidabile";
"toss.subtitle" = "Rendi stabile il lancio prima di aggiungere potenza.";
"toss.goal" = "Lanciare la palla sempre nello stesso punto, un po’ avanti e verso il lato del colpo.";
"toss.equipment" = "Racchetta, qualche pallina; la custodia della racchetta o un asciugamano come bersaglio";
"toss.cue" = "Accompagna, non lanciare. Rilascia all’altezza degli occhi.";
"toss.mistake" = "Usare il polso e far finire la palla dietro la testa.";
"toss.1.title" = "Trova il tuo punto";
"toss.1.body" = "Metti la custodia un passo davanti al piede avanti, verso il lato del colpo. Mettiti nella posizione di servizio.";
"toss.2.title" = "Lancia e lasciala cadere";
"toss.2.body" = "Lancia all’altezza del tuo braccio teso e lascia cadere la palla senza colpirla. Guarda dove atterra. Riposa il braccio ogni 10 lanci.";
"toss.3.title" = "Prova dei dieci lanci";
"toss.3.body" = "Fai 10 lanci. Conta quelli che cadono sul bersaglio o lo toccano.";
"second_serve.title" = "Una seconda di servizio di cui fidarti";
"second_serve.subtitle" = "Rotazione e margine prima della velocità.";
"second_serve.goal" = "Mettere in campo un servizio affidabile, alto sopra la rete e con un ritmo calmo.";
"second_serve.equipment" = "Campo, racchetta, 10+ palline";
"second_serve.cue" = "Mira più in alto sopra la rete e continua ad accelerare.";
"second_serve.mistake" = "Rallentare il braccio per accompagnare la palla dentro.";
"second_serve.1.title" = "Ritmo facile";
"second_serve.1.body" = "Scalda la spalla con servizi morbidi dalla linea del servizio, poi torna sulla linea di fondo.";
"second_serve.2.title" = "Supera la rete";
"second_serve.2.body" = "Servi a ritmo rilassato mirando a un’altezza di racchetta sopra la rete. Mantieni lo stesso movimento completo: la sicurezza viene dall’altezza, non da un braccio più lento. Riposa ogni 10 servizi.";
"second_serve.3.title" = "Dieci sotto pressione";
"second_serve.3.body" = "Tratta ogni servizio come una seconda. Servine 10 e conta quelli che cadono nel quadrato giusto.";
"wall_volley.title" = "Volée al muro";
"wall_volley.subtitle" = "Mani rapide e polso fermo contro il muro.";
"wall_volley.goal" = "Costruire una volée compatta, con preparazione corta e piatto corde stabile.";
"wall_volley.equipment" = "Muro di allenamento, racchetta, 1–2 palline";
"wall_volley.cue" = "Colpo corto, senza caricamento.";
"wall_volley.mistake" = "Colpire la palla invece di bloccarla.";
"wall_volley.1.title" = "Volée e afferra";
"wall_volley.1.body" = "Mettiti a 2–3 metri dal muro. Colpisci volée di dritto morbide e afferra la palla dopo ciascuna.";
"wall_volley.2.title" = "Tienila viva";
"wall_volley.2.body" = "Gioca volée senza interruzioni a ritmo calmo. Alterna volée di dritto e di rovescio quando ti senti pronto. Indietreggia se diventa troppo veloce.";
"wall_volley.3.title" = "Serie migliore";
"wall_volley.3.body" = "Conta la tua serie più lunga di volée senza rimbalzo.";
"split.title" = "Il tempo dello split step";
"split.subtitle" = "Atterra quando colpiscono, poi parti.";
"split.goal" = "Cronometrare un piccolo split step perché il primo passo sia rapido ed equilibrato.";
"split.equipment" = "Spazio libero in campo; 3 segnaposti piatti facoltativi";
"split.cue" = "Salta quando colpiscono, atterra quando leggi la palla.";
"split.mistake" = "Saltare troppo in alto o troppo presto e atterrare sui talloni.";
"split.1.title" = "Piccoli saltelli";
"split.1.body" = "Fai saltelli leggeri e bassi sugli avampiedi. Tieni le ginocchia morbide.";
"split.2.title" = "Salta e parti";
"split.2.body" = "Dal centro, immagina il colpo dell’avversario. Fai lo split step, un primo passo a sinistra o a destra verso un segnaposto, poi rientra. Alterna i lati e riposa tra un giro e l’altro.";
"split.3.title" = "Cinque giri";
"split.3.body" = "Fai 5 giri di split step, spostamento e rientro. Conta i giri in cui sei atterrato in equilibrio e sei partito senza esitare.";
"approach.title" = "Attacca e chiudi";
"approach.subtitle" = "Attacca una palla corta e chiudi a rete.";
"approach.goal" = "Riconoscere una palla corta, giocarla profonda e avanzare per la volée.";
"approach.equipment" = "Campo, racchetta, palline, un compagno che alza";
"approach.cue" = "Colpisci attraverso la palla e continua ad avanzare.";
"approach.mistake" = "Fermarsi dopo l’attacco e restare a metà campo.";
"approach.1.title" = "Palle corte";
"approach.1.body" = "Il tuo compagno alza una palla morbida che rimbalza vicino alla linea del servizio. Entra, giocala profonda e ricomincia.";
"approach.2.title" = "Attacco e volée";
"approach.2.body" = "Dopo l’attacco, fai uno split step vicino alla linea del servizio e gioca di volée la risposta morbida del compagno. Scambiatevi spesso i ruoli.";
"approach.3.title" = "Dieci attacchi";
"approach.3.body" = "Gioca 10 sequenze di attacco e volée. Conta quelle in cui entrambi i colpi sono buoni.";
"overhead.title" = "Pallonetto e smash";
"overhead.subtitle" = "Girati, indica e chiudi la palla alta.";
"overhead.goal" = "Seguire un pallonetto mettendosi di lato e colpire uno smash controllato.";
"overhead.equipment" = "Campo, racchetta, palline, un compagno che alza pallonetti";
"overhead.cue" = "Mettiti di lato e indica la palla con la mano libera.";
"overhead.mistake" = "Arretrare frontale alla rete e perdere l’equilibrio.";
"overhead.1.title" = "Girati e afferra";
"overhead.1.body" = "Il tuo compagno alza pallonetti morbidi. Mettiti di lato, indica la palla e afferrala con la mano libera.";
"overhead.2.title" = "Smash controllati";
"overhead.2.body" = "Colpisci smash al 75 % della velocità verso il campo avversario. Arretra con passi laterali invece di correre all’indietro. Scambiatevi i ruoli.";
"overhead.3.title" = "Dieci smash";
"overhead.3.body" = "Colpisci 10 smash. Conta quelli che cadono nel campo del singolare.";
"demo.description.shadow" = "Niente palla. Muoviti lungo la linea di fondo, colpisci e torna al centro dopo ogni colpo.";
"demo.description.split" = "Parti dal centro, fai lo split step, un primo passo verso un lato e rientra.";
"demo.description.approach" = "Avanza dal fondo verso la palla corta, giocala profonda e poi chiudi verso la rete.";
"demo.description.overhead" = "Il pallonetto passa sopra la tua testa. Mettiti di lato, poi colpisci lo smash nel campo avversario.";
"practice.close" = "Chiudi";
"notify.step.title" = "Passo completato";
"notify.step.body" = "%@ è terminato. Apri Ralli per il passo successivo.";
