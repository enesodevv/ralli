"about.contact" = "Contatta l’assistenza";
"about.safety.title" = "Sicurezza";
"about.sources.title" = "Fonti dei contenuti";
"about.sources.body" = "Gli esercizi sono scritti per Ralli e adattati da guide pubbliche della LTA e della USTA. Ralli è indipendente e non è affiliata, approvata né sponsorizzata dalla LTA, dalla USTA o da altre federazioni. Le animazioni dei colpi sono illustrazioni semplificate, non un’analisi tecnica.";
"about.version" = "Versione";
"privacy.title" = "Privacy";
"privacy.summary.title" = "In breve";
"privacy.summary.body" = "Ralli non ha account né accesso. Le tue note, la tua cronologia e le tue preferenze restano sul tuo iPhone; noi non possiamo vederle. Non vendiamo dati, non mostriamo pubblicità, non ti tracciamo e non usiamo strumenti di analisi o pubblicità di terze parti.";
"privacy.device.title" = "Cosa viene salvato sul tuo iPhone";
"privacy.device.body" = "Note delle lezioni, sessioni (data, esercizio, durata, risultato e riflessione facoltativi), preferenze e impostazioni dell’app. Se elimini l’app, vengono eliminati. I tuoi backup possono includerli secondo le condizioni di Apple.";
"privacy.speech.title" = "Microfono e voce";
"privacy.speech.body" = "Il microfono viene usato solo quando tocchi Aggiungi a voce in una nota. Sugli iPhone compatibili la voce viene riconosciuta interamente sul dispositivo; sugli altri può elaborarla il servizio vocale di Apple. Ralli non salva mai audio.";
"privacy.notifications.title" = "Notifiche";
"privacy.notifications.body" = "Se le consenti, Ralli ti avvisa quando un passo dell’allenamento finisce mentre l’app è in background. Le notifiche vengono create sul tuo dispositivo, non inviate da un server.";
"privacy.diagnostics.title" = "Diagnostica";
"privacy.diagnostics.body" = "Se nelle Impostazioni di iOS scegli di condividere le analisi con gli sviluppatori, Apple può inviarci rapporti anonimi su arresti anomali e prestazioni. Non contengono mai le tue note.";
"privacy.links.title" = "Altri siti web";
"privacy.links.body" = "Alcuni esercizi rimandano a guide di allenamento su altri siti, come quello della LTA. Quei siti hanno le proprie informative sulla privacy.";
"privacy.children.title" = "Minori";
"privacy.children.body" = "Ralli non è rivolta a minori di 13 anni.";
"privacy.rights.title" = "Hai il controllo";
"privacy.rights.body" = "Puoi modificare o eliminare ogni nota o sessione nell’app, cambiare i permessi nelle Impostazioni di iOS o eliminare l’app per rimuovere tutto. Per richieste ai sensi del GDPR, usa il contatto indicato nella pagina App Store di Ralli.";
