"dropfeed_fh.2.title" = "Zehnerserien";
"dropfeed_fh.2.body" = "Fallen lassen, aufspringen lassen, dann eine Cross-Vorhand hinter die Aufschlaglinie. Sammle die Bälle zwischen den Serien ein und mach Pause.";
"dropfeed_fh.3.title" = "Die letzten zehn";
"dropfeed_fh.3.body" = "Schlag 10 Vorhände aus dem Fallenlassen. Zähle die Bälle hinter der Aufschlaglinie und innerhalb des Einzelfelds.";
"dropfeed_bh.title" = "Rückhand aus dem Fallenlassen";
"dropfeed_bh.subtitle" = "Solo-Rückhände nach eigenem Zuspiel, cross.";
"dropfeed_bh.goal" = "Mit einem leichten, wiederholbaren Ball Sicherheit auf der Rückhand gewinnen.";
"dropfeed_bh.equipment" = "Platz, Schläger, 10+ Bälle, Korb oder Tasche";
"dropfeed_bh.cue" = "Dreh die Schultern, bevor der Ball aufspringt.";
"dropfeed_bh.mistake" = "Beim Treffen zum Netz schauen und mit dem Arm schieben.";
"dropfeed_bh.1.title" = "Die Drehung vorbereiten";
"dropfeed_bh.1.body" = "Stell dich seitlich, lass einen Ball fallen und zweimal aufspringen, während du die Schulterdrehung hältst. Wiederhole, bis sich die Drehung natürlich anfühlt.";
"dropfeed_bh.2.title" = "Zehnerserien";
"dropfeed_bh.2.body" = "Fallen lassen, einmal aufspringen lassen, dann eine Cross-Rückhand. Ein- oder beidhändig, im gleichen Rhythmus. Sammle die Bälle ein und mach Pause zwischen den Serien.";
"dropfeed_bh.3.title" = "Die letzten zehn";
"dropfeed_bh.3.body" = "Schlag 10 Rückhände. Zähle die Bälle, die cross im Einzelfeld landen.";
"toss.title" = "Ein verlässlicher Ballwurf";
"toss.subtitle" = "Erst den Ballwurf stabil machen, dann Kraft dazugeben.";
"toss.goal" = "Den Ball immer an dieselbe Stelle werfen, leicht vor dir und zur Schlagseite.";
"toss.equipment" = "Schläger, ein paar Bälle; Schlägerhülle oder Handtuch als Ziel";
"toss.cue" = "Heben statt werfen. Auf Augenhöhe loslassen.";
"toss.mistake" = "Aus dem Handgelenk werfen, sodass der Ball hinter den Kopf wandert.";
"toss.1.title" = "Finde deinen Punkt";
"toss.1.body" = "Leg die Schlägerhülle einen Schritt vor deinen vorderen Fuß, zur Schlagseite hin. Stell dich in deine Aufschlagposition.";
"toss.2.title" = "Werfen und fallen lassen";
"toss.2.body" = "Wirf auf deine Reichhöhe und lass den Ball fallen, ohne zu schlagen. Schau, wo er landet. Gönn dem Arm nach je 10 Würfen eine Pause.";
"toss.3.title" = "Zehn-Würfe-Test";
"toss.3.body" = "Mach 10 Würfe. Zähle die, die auf dem Ziel landen oder es berühren.";
"second_serve.title" = "Ein zweiter Aufschlag, dem du vertraust";
"second_serve.subtitle" = "Spin und Sicherheit vor Tempo.";
"second_serve.goal" = "Einen verlässlichen Aufschlag mit genug Höhe übers Netz und ruhigem Rhythmus ins Feld bringen.";
"second_serve.equipment" = "Platz, Schläger, 10+ Bälle";
"second_serve.cue" = "Ziel höher übers Netz und schwing weiter durch.";
"second_serve.mistake" = "Den Arm abbremsen, um den Ball hineinzulenken.";
"second_serve.1.title" = "Lockerer Rhythmus";
"second_serve.1.body" = "Wärm die Schulter mit sanften Aufschlägen von der Aufschlaglinie auf, dann geh zur Grundlinie zurück.";
"second_serve.2.title" = "Übers Netz";
"second_serve.2.body" = "Schlag entspannt auf und ziele eine Schlägerlänge über das Netz. Behalte den vollen Schwung: Die Sicherheit kommt von der Höhe, nicht von einem langsameren Arm. Mach nach je 10 Aufschlägen Pause.";
"second_serve.3.title" = "Zehn unter Druck";
"second_serve.3.body" = "Behandle jeden Aufschlag wie einen zweiten. Schlag 10 und zähle die, die im richtigen Aufschlagfeld landen.";
"wall_volley.title" = "Volleys an der Wand";
"wall_volley.subtitle" = "Schnelle Hände und festes Handgelenk an der Wand.";
"wall_volley.goal" = "Einen kompakten Volley mit kurzer Ausholbewegung und stabiler Schlagfläche aufbauen.";
"wall_volley.equipment" = "Trainingswand, Schläger, 1–2 Bälle";
"wall_volley.cue" = "Kurzer Stoß, kein Ausholen.";
"wall_volley.mistake" = "Den Ball schlagen, statt ihn zu blocken.";
"wall_volley.1.title" = "Volley und fangen";
"wall_volley.1.body" = "Stell dich 2–3 Meter vor die Wand. Spiel sanfte Vorhand-Volleys und fang den Ball nach jedem.";
"wall_volley.2.title" = "Dranbleiben";
"wall_volley.2.body" = "Spiel ohne Pause in ruhigem Tempo Volleys. Wechsle Vorhand- und Rückhand-Volleys ab, wenn du bereit bist. Geh einen Schritt zurück, wenn es zu schnell wird.";
"wall_volley.3.title" = "Beste Serie";
"wall_volley.3.body" = "Zähle deine längste Serie an Volleys ohne Aufsprung.";
"split.title" = "Split-Step-Timing";
"split.subtitle" = "Lande, wenn der Ball getroffen wird, dann los.";
"split.goal" = "Einen kleinen Split-Step so timen, dass dein erster Schritt schnell und ausbalanciert ist.";
"split.equipment" = "Freie Platzfläche; optional 3 flache Markierungen";
"split.cue" = "Spring, wenn sie schlagen, lande, wenn du den Ball liest.";
"split.mistake" = "Zu hoch oder zu früh springen und auf dem ganzen Fuß landen.";
"split.1.title" = "Kleine Sprünge";
"split.1.body" = "Mach leichte, flache Sprünge auf den Fußballen. Halte die Knie locker.";
"split.2.title" = "Springen und los";
"split.2.body" = "Stell dir aus der Mitte den Schlag des Gegners vor. Split-Step, erster Schritt nach links oder rechts zu einer Markierung, dann zurück. Wechsle die Seiten und mach Pausen zwischen den Runden.";
"split.3.title" = "Fünf Runden";
"split.3.body" = "Mach 5 Runden aus Split-Step, Bewegung und Rückweg. Zähle die Runden, in denen du ausbalanciert gelandet und ohne Zögern losgelaufen bist.";
"approach.title" = "Angriff ans Netz";
"approach.subtitle" = "Greif einen kurzen Ball an und beende am Netz.";
"approach.goal" = "Einen kurzen Ball erkennen, tief spielen und zum Volley nach vorn gehen.";
"approach.equipment" = "Platz, Schläger, Bälle, ein Partner zum Zuspielen";
"approach.cue" = "Schlag durch den Ball und geh weiter nach vorn.";
"approach.mistake" = "Nach dem Angriffsball stehen bleiben und im Niemandsland erwischt werden.";
"approach.1.title" = "Kurze Zuspiele";
"approach.1.body" = "Dein Partner spielt einen weichen Ball, der nahe der Aufschlaglinie aufspringt. Geh hinein, spiel ihn tief und starte neu.";
"approach.2.title" = "Angriff plus Volley";
"approach.2.body" = "Mach nach dem Angriffsball nahe der Aufschlaglinie einen Split-Step und spiel die sanfte Antwort deines Partners per Volley. Tauscht regelmäßig die Rollen.";
"approach.3.title" = "Zehn Angriffe";
"approach.3.body" = "Spiel 10 Folgen aus Angriffsball und Volley. Zähle die, bei denen beide Schläge im Feld landen.";
"overhead.title" = "Lob und Schmetterball";
"overhead.subtitle" = "Drehen, zeigen und den hohen Ball beenden.";
"overhead.goal" = "Einem Lob seitlich gedreht folgen und einen kontrollierten Schmetterball schlagen.";
"overhead.equipment" = "Platz, Schläger, Bälle, ein Partner für Lobs";
"overhead.cue" = "Dreh dich seitlich und zeig mit der freien Hand auf den Ball.";
"overhead.mistake" = "Mit Blick zum Netz rückwärts laufen und das Gleichgewicht verlieren.";
"overhead.1.title" = "Drehen und fangen";
"overhead.1.body" = "Dein Partner spielt sanfte Lobs. Dreh dich seitlich, zeig auf den Ball und fang ihn mit der freien Hand.";
"overhead.2.title" = "Kontrollierte Schmetterbälle";
"overhead.2.body" = "Schlag Schmetterbälle mit drei Viertel Tempo ins gegnerische Feld. Geh mit Seitschritten zurück, statt rückwärts zu rennen. Tauscht die Rollen.";
"overhead.3.title" = "Zehn Schmetterbälle";
"overhead.3.body" = "Schlag 10 Schmetterbälle. Zähle die, die im Einzelfeld landen.";
"demo.description.shadow" = "Kein Ball nötig. Beweg dich entlang der Grundlinie, schwing und kehr nach jedem Schlag zur Mitte zurück.";
"demo.description.split" = "Starte in der Mitte, mach einen Split-Step, einen ersten Schritt zur Seite und geh zurück.";
"demo.description.approach" = "Lauf von der Grundlinie zum kurzen Ball, spiel ihn tief und rück dann ans Netz vor.";
"demo.description.overhead" = "Der Lob kommt über deinen Kopf. Dreh dich seitlich und schmettere ins gegnerische Feld.";
