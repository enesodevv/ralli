/* About & privacy */
"about.title" = "Über Ralli";
"about.tagline" = "Deine Stunde, mitgenommen auf den Platz.";
"about.privacy" = "Datenschutzerklärung";
"about.permissions" = "Mikrofon- und Mitteilungseinstellungen";
"about.contact" = "Support kontaktieren";
"about.safety.title" = "Sicherheit";
"about.sources.title" = "Inhaltsquellen";
"about.sources.body" = "Die Übungen sind für Ralli geschrieben und an öffentlich verfügbare Leitfäden der LTA und der USTA angelehnt. Ralli ist unabhängig und steht in keiner Verbindung zur LTA, zur USTA oder zu einem anderen Verband und wird von diesen weder unterstützt noch gesponsert. Die Schlaganimationen sind vereinfachte Darstellungen, keine Technikanalyse.";
"about.version" = "Version";
"privacy.title" = "Datenschutz";
"privacy.summary.title" = "Kurz gesagt";
"privacy.summary.body" = "Ralli hat kein Konto und keine Anmeldung. Deine Notizen, dein Trainingsverlauf und deine Einstellungen bleiben auf deinem iPhone; wir können sie nicht sehen. Wir verkaufen keine Daten, zeigen keine Werbung, verfolgen dich nicht und nutzen keine Analyse- oder Werbetools von Drittanbietern.";
"privacy.device.title" = "Was auf deinem iPhone gespeichert wird";
"privacy.device.body" = "Notizen zur Stunde, Trainingseinheiten (Datum, Übung, Zeit, optionales Ergebnis und Gedanke), Einstellungen und App-Optionen. Wenn du die App löschst, werden sie gelöscht. Deine eigenen Backups können sie nach den Bedingungen von Apple enthalten.";
"privacy.speech.title" = "Mikrofon und Sprache";
"privacy.speech.body" = "Das Mikrofon wird nur genutzt, wenn du in einer Notiz auf Per Sprache hinzufügen tippst. Auf unterstützten iPhones wird die Sprache vollständig auf dem Gerät erkannt; auf anderen kann Apples Spracherkennung sie verarbeiten. Ralli speichert nie Audio.";
"privacy.notifications.title" = "Mitteilungen";
"privacy.notifications.body" = "Wenn du sie erlaubst, sagt dir Ralli, dass ein Trainingsschritt vorbei ist, während die App im Hintergrund läuft. Mitteilungen entstehen auf deinem Gerät und werden nicht von einem Server gesendet.";
"privacy.diagnostics.title" = "Diagnose";
"privacy.diagnostics.body" = "Wenn du in den iOS-Einstellungen Analysen mit App-Entwicklern teilst, kann Apple uns anonyme Absturz- und Leistungsberichte senden. Sie enthalten nie deine Notizen.";
"privacy.links.title" = "Andere Websites";
"privacy.links.body" = "Einige Übungen verlinken auf Trainingsleitfäden anderer Websites, etwa der LTA. Diese Websites haben eigene Datenschutzerklärungen.";
"privacy.children.title" = "Kinder";
"privacy.children.body" = "Ralli richtet sich nicht an Kinder unter 13 Jahren.";
"privacy.rights.title" = "Du hast die Kontrolle";
"privacy.rights.body" = "Du kannst jede Notiz und jede Einheit in der App bearbeiten oder löschen, Berechtigungen in den iOS-Einstellungen ändern oder die App löschen, um alles zu entfernen. Für Anfragen nach der DSGVO nutze den Kontakt auf der App-Store-Seite von Ralli.";
"privacy.updated" = "Zuletzt aktualisiert: November 2026";
