"about.title" = "Acerca de Ralli";
"about.tagline" = "Tu clase, llevada a la pista.";
"about.privacy" = "Política de privacidad";
"about.permissions" = "Ajustes de micrófono y notificaciones";
"about.contact" = "Contactar con soporte";
"about.safety.title" = "Seguridad";
"about.sources.title" = "Fuentes del contenido";
"about.sources.body" = "Los ejercicios están escritos para Ralli y adaptados de guías públicas de la LTA y la USTA. Ralli es independiente y no está vinculada, respaldada ni patrocinada por la LTA, la USTA ni ninguna otra federación. Las animaciones de golpes son ilustraciones simplificadas, no un análisis técnico.";
"about.version" = "Versión";
"privacy.title" = "Privacidad";
"privacy.summary.title" = "En resumen";
"privacy.summary.body" = "Ralli no tiene cuentas ni inicio de sesión. Tus notas, tu historial y tus preferencias se quedan en tu iPhone; nosotros no podemos verlos. No vendemos datos, no mostramos anuncios ni te rastreamos, y no usamos herramientas de analítica ni de publicidad de terceros.";
"privacy.device.title" = "Qué se guarda en tu iPhone";
"privacy.device.body" = "Notas de clase, sesiones de práctica (fecha, ejercicio, tiempo, resultado y reflexión opcionales), preferencias y ajustes de la app. Si borras la app, se borran. Tus copias de seguridad pueden incluirlos según las condiciones de Apple.";
"privacy.speech.title" = "Micrófono y voz";
"privacy.speech.body" = "El micrófono solo se usa cuando tocas Añadir por voz en una nota. En los iPhone compatibles, la voz se reconoce por completo en el dispositivo; en los demás puede procesarla el servicio de voz de Apple. Ralli nunca guarda audio.";
"privacy.notifications.title" = "Notificaciones";
"privacy.notifications.body" = "Si las permites, Ralli te avisa cuando termina un paso de la práctica mientras la app está en segundo plano. Las notificaciones se crean en tu dispositivo, no se envían desde un servidor.";
"privacy.diagnostics.title" = "Diagnóstico";
"privacy.diagnostics.body" = "Si en Ajustes de iOS decides compartir análisis con los desarrolladores, Apple puede enviarnos informes anónimos de fallos y rendimiento. Nunca contienen tus notas.";
"privacy.links.title" = "Otros sitios web";
"privacy.links.body" = "Algunos ejercicios enlazan a guías de entrenamiento de otros sitios, como la LTA. Esos sitios tienen sus propias políticas de privacidad.";
"privacy.children.title" = "Menores";
"privacy.children.body" = "Ralli no está dirigida a menores de 13 años.";
"privacy.rights.title" = "Tú tienes el control";
"privacy.rights.body" = "Puedes editar o eliminar cualquier nota o sesión en la app, cambiar los permisos en Ajustes de iOS o borrar la app para eliminarlo todo. Para solicitudes según el RGPD, usa el contacto de la página de Ralli en el App Store.";
"privacy.updated" = "Última actualización: noviembre de 2026";
