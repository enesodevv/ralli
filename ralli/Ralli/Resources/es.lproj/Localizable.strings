"dropfeed_bh.3.title" = "Las diez finales";
"dropfeed_bh.3.body" = "Pega 10 reveses. Cuenta las bolas que caen cruzadas dentro de la pista de individuales.";
"toss.title" = "Un lanzamiento fiable";
"toss.subtitle" = "Estabiliza el lanzamiento antes de añadir potencia.";
"toss.goal" = "Lanzar la bola siempre al mismo sitio, algo por delante y hacia tu lado de golpeo.";
"toss.equipment" = "Raqueta, unas bolas; la funda de la raqueta o una toalla como objetivo";
"toss.cue" = "Eleva, no lances. Suelta a la altura de los ojos.";
"toss.mistake" = "Mover la muñeca y que la bola se vaya detrás de la cabeza.";
"toss.1.title" = "Encuentra tu punto";
"toss.1.body" = "Pon la funda un paso por delante de tu pie delantero, hacia tu lado de golpeo. Colócate en tu posición de saque.";
"toss.2.title" = "Lanza y deja caer";
"toss.2.body" = "Lanza a la altura de tu alcance y deja caer la bola sin golpearla. Mira dónde cae. Descansa el brazo cada 10 lanzamientos.";
"toss.3.title" = "Prueba de diez lanzamientos";
"toss.3.body" = "Haz 10 lanzamientos. Cuenta los que caen sobre el objetivo o lo tocan.";
"second_serve.title" = "Un segundo saque de confianza";
"second_serve.subtitle" = "Efecto y margen antes que velocidad.";
"second_serve.goal" = "Meter un saque fiable, con altura sobre la red y un ritmo tranquilo.";
"second_serve.equipment" = "Pista, raqueta, 10 bolas o más";
"second_serve.cue" = "Apunta más alto sobre la red y no frenes el brazo.";
"second_serve.mistake" = "Frenar el brazo para guiar la bola dentro.";
"second_serve.1.title" = "Ritmo fácil";
"second_serve.1.body" = "Calienta el hombro con saques suaves desde la línea de saque y luego vuelve a la línea de fondo.";
"second_serve.2.title" = "Supera la red";
"second_serve.2.body" = "Saca a ritmo tranquilo, apuntando una raqueta por encima de la red. Mantén el mismo movimiento completo: que la seguridad venga de la altura, no de un brazo más lento. Descansa cada 10 saques.";
"second_serve.3.title" = "Diez bajo presión";
"second_serve.3.body" = "Trata cada saque como un segundo saque. Saca 10 y cuenta los que caen en el cuadro correcto.";
"wall_volley.title" = "Voleas contra el frontón";
"wall_volley.subtitle" = "Manos rápidas y muñeca firme contra el frontón.";
"wall_volley.goal" = "Construir una volea compacta, con preparación corta y la cara de la raqueta estable.";
"wall_volley.equipment" = "Frontón, raqueta, 1–2 bolas";
"wall_volley.cue" = "Golpe corto, sin armado.";
"wall_volley.mistake" = "Pegarle a la bola en lugar de bloquearla.";
"wall_volley.1.title" = "Volea y atrapa";
"wall_volley.1.body" = "Colócate a 2–3 metros del frontón. Pega voleas de derecha suaves y atrapa la bola después de cada una.";
"wall_volley.2.title" = "Mantén la serie";
"wall_volley.2.body" = "Volea sin parar a ritmo tranquilo. Alterna voleas de derecha y de revés cuando te sientas preparado. Retrocede si va demasiado rápido.";
"wall_volley.3.title" = "Tu mejor serie";
"wall_volley.3.body" = "Cuenta tu serie más larga de voleas sin bote.";
"split.title" = "El momento del split step";
"split.subtitle" = "Aterriza cuando golpean y luego muévete.";
"split.goal" = "Ajustar un pequeño split step para que tu primer paso sea rápido y equilibrado.";
"split.equipment" = "Espacio libre en pista; 3 conos planos opcionales";
"split.cue" = "Salta cuando golpean, aterriza cuando lees la bola.";
"split.mistake" = "Saltar demasiado alto o demasiado pronto y caer con el pie plano.";
"split.1.title" = "Saltitos";
"split.1.body" = "Haz saltos ligeros y bajos sobre la parte delantera del pie. Mantén las rodillas flexibles.";
"split.2.title" = "Salta y sal";
"split.2.body" = "Desde el centro, imagina el golpe del rival. Haz el split step, da un primer paso a izquierda o derecha hacia un cono y vuelve. Alterna lados y descansa entre rondas.";
"split.3.title" = "Cinco rondas";
"split.3.body" = "Haz 5 rondas de split step, desplazamiento y vuelta. Cuenta las rondas en las que aterrizaste en equilibrio y saliste sin pausa.";
"approach.title" = "Sube y cierra";
"approach.subtitle" = "Ataca una bola corta y termina en la red.";
"approach.goal" = "Reconocer una bola corta, golpearla profunda y avanzar para volear.";
"approach.equipment" = "Pista, raqueta, bolas, un compañero que lance";
"approach.cue" = "Golpea a través de la bola y sigue avanzando.";
"approach.mistake" = "Pararte tras el golpe de aproximación y quedarte en media pista.";
"approach.1.title" = "Bolas cortas";
"approach.1.body" = "Tu compañero lanza una bola suave que bota cerca de la línea de saque. Entra, golpéala profunda y vuelve a empezar.";
"approach.2.title" = "Aproximación y volea";
"approach.2.body" = "Tras la aproximación, haz el split step cerca de la línea de saque y volea la devolución suave de tu compañero. Cambiad de papel con frecuencia.";
"approach.3.title" = "Diez aproximaciones";
"approach.3.body" = "Juega 10 secuencias de aproximación y volea. Cuenta aquellas en las que ambos golpes entran.";
"overhead.title" = "Globo y remate";
"overhead.subtitle" = "Gira, señala y termina la bola alta.";
"overhead.goal" = "Seguir un globo girándote de perfil y pegar un remate controlado.";
"overhead.equipment" = "Pista, raqueta, bolas, un compañero que tire globos";
"overhead.cue" = "Ponte de perfil y señala la bola con la mano libre.";
"overhead.mistake" = "Retroceder de frente a la red y perder el equilibrio.";
"overhead.1.title" = "Gira y atrapa";
"overhead.1.body" = "Tu compañero tira globos suaves. Ponte de perfil, señala y atrapa la bola con la mano libre.";
"overhead.2.title" = "Remates controlados";
"overhead.2.body" = "Remata al 75 % hacia la pista contraria. Retrocede con pasos laterales en lugar de correr hacia atrás. Cambiad de papel.";
"overhead.3.title" = "Diez remates";
"overhead.3.body" = "Pega 10 remates. Cuenta los que caen dentro de la pista de individuales.";
"demo.description.shadow" = "Sin bola. Desplázate por la línea de fondo, golpea y vuelve al centro después de cada golpe.";
"demo.description.split" = "Empieza en el centro, haz el split step, da un primer paso hacia un lado y vuelve.";
"demo.description.approach" = "Entra desde el fondo hacia la bola corta, golpea profundo y cierra hacia la red.";
"demo.description.overhead" = "El globo pasa por encima de tu cabeza. Ponte de perfil y remata hacia la pista contraria.";
