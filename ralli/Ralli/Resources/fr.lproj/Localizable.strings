/* About & privacy */
"about.title" = "À propos de Ralli";
"about.tagline" = "Ton cours, emporté sur le court.";
"about.privacy" = "Politique de confidentialité";
"about.permissions" = "Réglages du micro et des notifications";
"about.contact" = "Contacter l’assistance";
"about.safety.title" = "Sécurité";
"about.sources.title" = "Sources du contenu";
"about.sources.body" = "Les exercices sont écrits pour Ralli et adaptés de guides publics de la LTA et de l’USTA. Ralli est indépendante et n’est ni affiliée, ni approuvée, ni sponsorisée par la LTA, l’USTA ou toute autre fédération. Les animations de coups sont des illustrations simplifiées, pas une analyse technique.";
"about.version" = "Version";
"privacy.title" = "Confidentialité";
"privacy.summary.title" = "En bref";
"privacy.summary.body" = "Ralli n’a ni compte ni connexion. Tes notes, ton historique et tes préférences restent sur ton iPhone ; nous ne pouvons pas les voir. Nous ne vendons pas de données, n’affichons pas de publicité, ne te pistons pas et n’utilisons aucun outil d’analyse ou de publicité tiers.";
"privacy.device.title" = "Ce qui est stocké sur ton iPhone";
"privacy.device.body" = "Notes de cours, séances (date, exercice, durée, résultat et réflexion facultatifs), préférences et réglages de l’app. Si tu supprimes l’app, ils sont supprimés. Tes propres sauvegardes peuvent les inclure, selon les conditions d’Apple.";
"privacy.speech.title" = "Micro et voix";
"privacy.speech.body" = "Le micro n’est utilisé que lorsque tu touches Ajouter à la voix dans une note. Sur les iPhone compatibles, la voix est reconnue entièrement sur l’appareil ; sur les autres, le service vocal d’Apple peut la traiter. Ralli n’enregistre jamais d’audio.";
"privacy.notifications.title" = "Notifications";
"privacy.notifications.body" = "Si tu les autorises, Ralli te prévient quand une étape se termine pendant que l’app est en arrière-plan. Les notifications sont créées sur ton appareil, pas envoyées par un serveur.";
"privacy.diagnostics.title" = "Diagnostics";
"privacy.diagnostics.body" = "Si tu choisis, dans les Réglages d’iOS, de partager les analyses avec les développeurs, Apple peut nous envoyer des rapports anonymes de plantage et de performances. Ils ne contiennent jamais tes notes.";
"privacy.links.title" = "Autres sites web";
"privacy.links.body" = "Certains exercices renvoient vers des guides d’entraînement sur d’autres sites, comme celui de la LTA. Ces sites ont leur propre politique de confidentialité.";
"privacy.children.title" = "Enfants";
"privacy.children.body" = "Ralli ne s’adresse pas aux enfants de moins de 13 ans.";
"privacy.rights.title" = "Tu gardes le contrôle";
"privacy.rights.body" = "Tu peux modifier ou supprimer chaque note ou séance dans l’app, changer les autorisations dans les Réglages d’iOS ou supprimer l’app pour tout effacer. Pour toute demande au titre du RGPD, utilise le contact indiqué sur la page App Store de Ralli.";
"privacy.updated" = "Dernière mise à jour : novembre 2026";
