"dropfeed_bh.2.title" = "Séries de dix balles";
"dropfeed_bh.2.body" = "Lâche, laisse un rebond, puis frappe un revers croisé. À une ou deux mains, garde le même rythme. Ramasse les balles et récupère entre les séries.";
"dropfeed_bh.3.title" = "Les dix dernières";
"dropfeed_bh.3.body" = "Frappe 10 revers. Compte les balles qui tombent croisées dans le court de simple.";
"toss.title" = "Un lancer fiable";
"toss.subtitle" = "Stabilise le lancer avant d’ajouter de la puissance.";
"toss.goal" = "Lancer la balle toujours au même endroit, un peu devant toi et du côté de ta frappe.";
"toss.equipment" = "Raquette, quelques balles ; une housse ou une serviette comme cible";
"toss.cue" = "Monte la balle, ne la jette pas. Lâche-la à hauteur des yeux.";
"toss.mistake" = "Casser le poignet et laisser la balle partir derrière la tête.";
"toss.1.title" = "Trouve ton repère";
"toss.1.body" = "Pose ta housse un pas devant ton pied avant, du côté de ta frappe. Mets-toi en position de service.";
"toss.2.title" = "Lance et laisse tomber";
"toss.2.body" = "Lance à hauteur de ton allonge et laisse tomber la balle sans frapper. Regarde où elle tombe. Repose ton bras tous les 10 lancers.";
"toss.3.title" = "Test des dix lancers";
"toss.3.body" = "Fais 10 lancers. Compte ceux qui tombent sur la cible ou la touchent.";
"second_serve.title" = "Une deuxième balle de confiance";
"second_serve.subtitle" = "Effet et marge avant la vitesse.";
"second_serve.goal" = "Passer un service fiable, avec de la hauteur au-dessus du filet et un rythme calme.";
"second_serve.equipment" = "Court, raquette, 10 balles ou plus";
"second_serve.cue" = "Vise plus haut au-dessus du filet et continue d’accélérer.";
"second_serve.mistake" = "Freiner le bras pour guider la balle dans le carré.";
"second_serve.1.title" = "Rythme facile";
"second_serve.1.body" = "Échauffe ton épaule avec des services doux depuis la ligne de service, puis recule à la ligne de fond.";
"second_serve.2.title" = "Passe le filet";
"second_serve.2.body" = "Sers à un rythme détendu en visant une hauteur de raquette au-dessus du filet. Garde le même geste complet : la sécurité vient de la hauteur, pas d’un bras plus lent. Récupère tous les 10 services.";
"second_serve.3.title" = "Dix sous pression";
"second_serve.3.body" = "Traite chaque service comme une deuxième balle. Sers 10 fois et compte ceux qui tombent dans le bon carré.";
"wall_volley.title" = "Volées au mur";
"wall_volley.subtitle" = "Mains rapides et poignet ferme contre le mur.";
"wall_volley.goal" = "Construire une volée compacte, avec une préparation courte et un tamis stable.";
"wall_volley.equipment" = "Mur d’entraînement, raquette, 1–2 balles";
"wall_volley.cue" = "Frappe courte, sans armer.";
"wall_volley.mistake" = "Frapper la balle au lieu de la bloquer.";
"wall_volley.1.title" = "Volée et rattrape";
"wall_volley.1.body" = "Place-toi à 2–3 mètres du mur. Fais des volées de coup droit douces et rattrape la balle après chacune.";
"wall_volley.2.title" = "Fais durer";
"wall_volley.2.body" = "Enchaîne les volées à un rythme calme. Alterne volées de coup droit et de revers quand tu te sens prêt. Recule si ça va trop vite.";
"wall_volley.3.title" = "Meilleure série";
"wall_volley.3.body" = "Compte ta plus longue série de volées sans rebond.";
"split.title" = "Le timing du split-step";
"split.subtitle" = "Atterris au moment de la frappe, puis démarre.";
"split.goal" = "Placer un petit split-step au bon moment pour que ton premier pas soit rapide et équilibré.";
"split.equipment" = "Espace libre sur le court ; 3 plots plats en option";
"split.cue" = "Saute quand il frappe, atterris quand tu lis la balle.";
"split.mistake" = "Sauter trop haut ou trop tôt et retomber à plat.";
"split.1.title" = "Petits sauts";
"split.1.body" = "Fais des sauts légers et bas sur l’avant des pieds. Garde les genoux souples.";
"split.2.title" = "Saute et pars";
"split.2.body" = "Depuis le centre, imagine la frappe de l’adversaire. Split-step, premier pas à gauche ou à droite vers un plot, puis replace-toi. Alterne les côtés et récupère entre les tours.";
"split.3.title" = "Cinq tours";
"split.3.body" = "Fais 5 tours de split-step, déplacement et replacement. Compte les tours où tu as atterri en équilibre et démarré sans hésiter.";
"approach.title" = "Monter et conclure";
"approach.subtitle" = "Attaque une balle courte et finis au filet.";
"approach.goal" = "Repérer une balle courte, la jouer en profondeur et avancer pour volleyer.";
"approach.equipment" = "Court, raquette, balles, un partenaire qui distribue";
"approach.cue" = "Frappe à travers la balle et continue d’avancer.";
"approach.mistake" = "S’arrêter après l’approche et se faire piéger en milieu de court.";
"approach.1.title" = "Balles courtes";
"approach.1.body" = "Ton partenaire envoie une balle douce qui rebondit près de la ligne de service. Avance, joue-la en profondeur, puis recommence.";
"approach.2.title" = "Approche et volée";
"approach.2.body" = "Après l’approche, fais un split-step près de la ligne de service puis volleye la réponse douce de ton partenaire. Inversez régulièrement les rôles.";
"approach.3.title" = "Dix approches";
"approach.3.body" = "Joue 10 séquences approche-volée. Compte celles où les deux coups sont bons.";
"overhead.title" = "Lob et smash";
"overhead.subtitle" = "Tourne, vise et conclus la balle haute.";
"overhead.goal" = "Suivre un lob en se mettant de profil et frapper un smash contrôlé.";
"overhead.equipment" = "Court, raquette, balles, un partenaire qui lobe";
"overhead.cue" = "Mets-toi de profil et vise la balle avec ta main libre.";
"overhead.mistake" = "Reculer face au filet et perdre l’équilibre.";
"overhead.1.title" = "Tourne et attrape";
"overhead.1.body" = "Ton partenaire envoie des lobs doux. Mets-toi de profil, vise la balle et attrape-la avec ta main libre.";
"overhead.2.title" = "Smashs contrôlés";
"overhead.2.body" = "Smashe aux trois quarts de ta vitesse dans le court adverse. Recule en pas chassés au lieu de courir à reculons. Inversez les rôles.";
"overhead.3.title" = "Dix smashs";
"overhead.3.body" = "Frappe 10 smashs. Compte ceux qui tombent dans le court de simple.";
"demo.description.shadow" = "Pas de balle. Déplace-toi le long de la ligne de fond, frappe et reviens au centre après chaque coup.";
"demo.description.split" = "Pars du centre, fais un split-step, un premier pas d’un côté, puis replace-toi.";
"demo.description.approach" = "Avance depuis le fond vers la balle courte, joue en profondeur, puis monte vers le filet.";
"demo.description.overhead" = "Le lob passe au-dessus de ta tête. Mets-toi de profil, puis smashe dans le court adverse.";
"practice.close" = "Fermer";
"notify.step.title" = "Étape terminée";
"notify.step.body" = "%@ est terminée. Ouvre Ralli pour l’étape suivante.";
